# Variáveis obrigatórias do Oráculo.
#
# Este arquivo documenta os nomes; nunca traz valores. O arquivo real (.env)
# fica FORA do document root e nunca é versionado.
#
# Não existe valor default no código: se qualquer variável faltar, a aplicação
# falha ao subir nomeando a que está ausente. Um fallback literal ao lado da
# variável é um segredo commitado com passo extra.

# Ambiente: local | staging | production
# Em 'local', o seed cria os usuários de demonstração documentados no README.
# Em qualquer outro, cria um único administrador com senha aleatória.
APP_ENV=

# URL pública da aplicação, sem barra ao final. Define se o cookie de sessão
# recebe o atributo Secure.
APP_URL=

# Banco de dados
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# Tempo de vida da sessão, em segundos (43200 = 12 horas).
SESSION_TTL_SECONDS=

# Tamanho máximo de imagem enviada, em bytes (3145728 = 3 MB).
UPLOAD_MAX_BYTES=
